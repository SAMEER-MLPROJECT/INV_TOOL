# Copy to .env and adjust. Never commit .env.

# Graph backend: "memory" (default, zero configuration) or "neo4j"
AGL_GRAPH_BACKEND=memory

# Neo4j / Neo4j AuraDB (only needed when AGL_GRAPH_BACKEND=neo4j)
# AuraDB URIs look like: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Limits
AGL_MAX_UPLOAD_MB=20
AGL_MAX_RECORDS_PER_FILE=200000

# Optional path overrides
# AGL_SAMPLE_DIR=data/sample
# AGL_EXPORT_DIR=data/exports
# AGL_FRONTEND_DIST=frontend/dist
